{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SIPL Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-sipl"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-sipl/out/**/*.js"
      ]
    }
  ]
}